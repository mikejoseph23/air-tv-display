<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lives in the iadev.net/air-tv-display/ download folder (IIS virtual directory; physical path
  is the LymeDeploy PublishRoot variable). IIS has no built-in MIME mapping for .dmg, so without
  this the download serves 404. publish-files treats this file as protected: a changed copy
  fails the deploy for a manual merge rather than overwriting the live one. Copied from
  mac-resource-monitor's.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".dmg" />
      <mimeMap fileExtension=".dmg" mimeType="application/x-apple-diskimage" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
